POSTGRES_USER=roboops_user
POSTGRES_PASSWORD=roboops_pass
POSTGRES_DB=roboops_db

# These URLs are for LOCAL execution outside Docker (uvicorn run directly on
# the host), so they use the host-mapped port 5433. When running via
# "docker compose up", docker-compose.yml overrides DATABASE_URL,
# TEST_DATABASE_URL and MIGRATION_TEST_DATABASE_URL for the backend
# container to point at postgres:5432 instead - see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://roboops_user:roboops_pass@localhost:5433/roboops_db
TEST_DATABASE_URL=postgresql+psycopg://roboops_user:roboops_pass@localhost:5433/roboops_test_db
MIGRATION_TEST_DATABASE_URL=postgresql+psycopg://roboops_user:roboops_pass@localhost:5433/roboops_migration_test_db

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
# Example only: set a real secret in a local .env file that is not committed.
JWT_SECRET_KEY=local-dev-example-jwt-secret-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=30

# Development-only HTTP telemetry simulator settings. Use fake/local values;
# do not commit real credentials.
ROBOOPS_API_URL=http://localhost:8000
ROBOOPS_SIMULATOR_EMAIL=simulator-operator@example.invalid
ROBOOPS_SIMULATOR_PASSWORD=replace-with-local-password
ROBOOPS_SIMULATOR_INTERVAL_SECONDS=30
ROBOOPS_SIMULATOR_SEED=20260910
ROBOOPS_SIMULATOR_TIMEOUT_SECONDS=10
# JSON array; replace UUIDs with sensors from your local seeded database.
ROBOOPS_SIMULATOR_SENSORS='[{"sensor_id":"11111111-1111-1111-1111-111111111111","robot_id":"22222222-2222-2222-2222-222222222222","robot_code":"RBT-001","sensor_type":"battery","unit":"percent"}]'

# Phase 8A local Kafka producer settings. A broker is not included yet.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=roboops.telemetry.readings.v1
KAFKA_CLIENT_ID=roboops-telemetry-simulator
KAFKA_CONSUMER_GROUP=roboops-telemetry-persistence
KAFKA_POLL_TIMEOUT_SECONDS=1.0
KAFKA_CONSUMER_CLIENT_ID=roboops-telemetry-consumer
